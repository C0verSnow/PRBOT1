# 指定要让 Codex 直接操作的项目绝对路径。留空则使用本仓库目录。
CODEX_WORKSPACE=
# 留空使用本机 Codex 登录和默认模型；API key 只保存在服务端。
CODEX_API_KEY=
CODEX_MODEL=
# 可选：覆盖 SDK 自带的 Codex CLI 路径。
CODEX_PATH_OVERRIDE=
# 聊天记录目录，默认 .data；不要放进公开仓库。
PRBOT_DATA_DIR=.data

# 可选：已有的 Codex 配置/登录/会话目录；留空使用当前用户默认目录。
CODEX_HOME=
# 非敏感设置文件，默认 PRBOT_DATA_DIR/settings.json；桌面由用户目录固定管理。
# PRBOT_SETTINGS_FILE=/absolute/path/settings.json
