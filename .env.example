# 指定要让 Codex 直接操作的项目绝对路径。留空则使用本仓库目录。
CODEX_WORKSPACE=
# 留空使用本机 Codex 登录和默认模型；API key 只保存在服务端。
CODEX_API_KEY=
CODEX_MODEL=
# 可选：覆盖 SDK 自带的 Codex CLI 路径。
CODEX_PATH_OVERRIDE=
# 聊天记录目录，默认 .data；不要放进公开仓库。
PRBOT_DATA_DIR=.data

# 可选：已有的 Codex 配置/插件/登录/会话目录；留空使用当前用户默认目录。
# Telegram 复用同一目录，不额外建立隔离的 CODEX_HOME。
CODEX_HOME=
# 非敏感设置文件，默认 PRBOT_DATA_DIR/settings.json；桌面由用户目录固定管理。
# PRBOT_SETTINGS_FILE=/absolute/path/settings.json

# Telegram 运行时密钥仍通过设置页配置的 Infisical 获取：PR_BOT_TOKEN 和 Upstash 两项。
# 默认长轮询；可选 webhook，需要常驻 Node 进程与专用 HTTPS 反向代理路径。
PRBOT_TELEGRAM_TRANSPORT=polling
# webhook 模式必填：16–256 位字母、数字、下划线或短横线随机值。
PRBOT_TELEGRAM_WEBHOOK_SECRET=
# Issue 读取与 PR 创建复用当前 Codex 已启用并授权的 GitHub 插件。
# 无需另配 GitHub API Token；Git commit/push 使用本机现有 Git 身份与凭据。
